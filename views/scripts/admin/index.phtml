<?php $s = $this->status; ?>
<?php if (!empty($s['stands_down'])): ?>
    <div class="alert alert-info d-flex align-items-center" role="alert">
        <i class="fa-solid fa-circle-info me-2"></i>
        <div>This host manages SSL for you (e.g. cPanel AutoSSL). <strong>TigerSSL is standing down</strong> —
            your certificates are already handled by the host.</div>
    </div>
<?php else: ?>
    <div class="alert alert-<?= empty($s['acme_ready']) ? 'warning' : 'success' ?> d-flex align-items-center" role="alert">
        <i class="fa-solid fa-server me-2"></i>
        <div>
            You own this server — TigerSSL will issue certificates (<strong><?= $this->escape($s['ca']) ?></strong> CA)
            using the <strong><?= $this->escape($s['strategy']) ?></strong> strategy.
            <?php if (empty($s['acme_ready'])): ?>
                <span class="text-warning-emphasis">The ACME engine isn't installed yet — issuance is pending (see docs).</span>
            <?php endif; ?>
            <?php if (empty($s['openssl'])): ?>
                <span class="text-danger">PHP's <code>openssl</code> extension is required.</span>
            <?php endif; ?>
        </div>
    </div>
<?php endif; ?>

