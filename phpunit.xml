<?xml version="1.0" encoding="UTF-8"?>
<!--
  TigerSSL PHPUnit config. One suite:
    unit  — no DB, no network. The HTTP-01 challenge store (file-backed) + the certificate service's
            pure helpers (SAN parsing, filesystem-safe naming, config resolution, host/SSL status).

  Dependencies (Tiger_*/Zend_*/PHPUnit) resolve from a sibling tiger-core checkout's vendor/ (or
  $TIGER_CORE_VENDOR) — this module has no runtime vendor of its own. Run with that checkout's phpunit:
    ../tiger-core/vendor/bin/phpunit
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true">

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">services</directory>
            <directory suffix=".php">models</directory>
            <directory suffix=".php">controllers</directory>
            <directory suffix=".php">forms</directory>
        </include>
        <exclude>
            <directory>vendor-lib</directory>
            <directory>migrations</directory>
            <directory suffix=".php">languages</directory>
        </exclude>
    </source>

    <php>
        <env name="APPLICATION_ENV" value="testing"/>
    </php>
</phpunit>
